{
  "manifest_version": 3,
  "name": "ElPicker",
  "version": "1.0.0",
  "description": "Your friendly, versatile context pal. Click to select elements, navigate DOM hierarchy, and extract context as CSS selectors, XPath, or HTML.",
  "permissions": ["activeTab", "clipboardWrite", "storage"],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "activate-picker": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "MacCtrl+Shift+E"
      },
      "description": "Activate ElPicker"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
